{
  "name": "@md/cf-page",
  "version": "0.6.1",
  "license": "ISC",
  "tasks": {
    "starter:build": "( cd starter ; deno run -A ../src/mod.ts build )",
    "starter:dev": "( cd starter ; deno run -A  --env-file --watch --watch-exclude=. ../src/mod.ts serve )",
    "starter:perf": "( cd starter ; deno run -A  --env-file --watch --watch-exclude=. ../src/mod.ts serve --measure-performance )",
    "docs:build": "( cd docs ; deno run -A ../src/mod.ts build )",
    "docs:dev": "( cd docs ; deno run -A  --env-file --watch --watch-exclude=. ../src/mod.ts serve )",
    "docs:perf": "( cd docs ; deno run -A  --env-file --watch --watch-exclude=. ../src/mod.ts serve --measure-performance )"
  },
  "exports": "./src/mod.ts",
  "imports": {
    "@cloudflare/workers-types": "npm:@cloudflare/workers-types@^4.20250607.0",
    "@deno/emit": "jsr:@deno/emit@^0.46.0",
    "@jsdevtools/rehype-inline-svg": "npm:@jsdevtools/rehype-inline-svg@^1.1.4",
    "@md/cli": "jsr:@md/cli@^0.0.2",
    "@md/compare-array-buffers": "jsr:@md/compare-array-buffers@^0.0.0",
    "@md/ensure-error": "jsr:@md/ensure-error@^0.0.0",
    "@md/file-hash": "jsr:@md/file-hash@^1.0.0",
    "@md/resolvable": "jsr:@md/resolvable@^0.0.0",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/fs": "jsr:@std/fs@^1.0.18",
    "@std/jsonc": "jsr:@std/jsonc@^1.0.2",
    "@std/media-types": "jsr:@std/media-types@^1.1.0",
    "@std/path": "jsr:@std/path@^1.1.0",
    "@std/tar": "jsr:@std/tar@^0.1.6",
    "@std/yaml": "jsr:@std/yaml@^1.0.7",
    "@tailwindcss/postcss": "npm:@tailwindcss/postcss@^4.1.8",
    "autoprefixer": "npm:autoprefixer@^10.4.21",
    "cssnano": "npm:cssnano@^7.0.7",
    "postcss": "npm:postcss@^8.5.4",
    "rehype": "npm:rehype@^13.0.2",
    "rehype-preset-minify": "npm:rehype-preset-minify@^7.0.1",
    "rehype-slug": "npm:rehype-slug@^6.0.0",
    "rehype-stringify": "npm:rehype-stringify@^10.0.1",
    "remark-parse": "npm:remark-parse@^11.0.0",
    "remark-rehype": "npm:remark-rehype@^11.1.2",
    "sass": "npm:sass@^1.89.1",
    "tailwindcss": "npm:tailwindcss@^4",
    "unified": "npm:unified@^11.0.5",
    "unist-util-visit": "npm:unist-util-visit@^5.0.0",
    "zod": "npm:zod@^3.25.56"
  },
  "nodeModulesDir": "auto", // Required by tailwind to work
  "publish": {
    "include": ["src/", "deno.json", "deno.lock", "README.md"],
    "exclude": ["**/*.test.ts"]
  },
  "compilerOptions": {
    "types": ["./src/types.d.ts", "npm:@cloudflare/workers-types"]
  }
}
