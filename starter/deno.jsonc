{
  "tasks": {
    "dev": "deno run --env-file -A --allow-scripts --watch='.env,deno.jsonc' jsr:@md/cf-page serve",
    "build": "deno run -A --allow-scripts jsr:@md/cf-page build"
  },
  "compilerOptions": {
    "types": ["npm:@cloudflare/workers-types"],
    "lib": ["es2024", "dom"]
  },
  "imports": {
    "@src/": "./src/",
    "@lib/": "./lib/",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "tailwindcss": "npm:tailwindcss@^4", // Specify the version of Tailwind CSS
    "@md/on-dom-ready": "jsr:@md/on-dom-ready@^0.0.1",
    "@md/cf-page": "jsr:@md/cf-page"
  },
  "nodeModulesDir": "auto",
  "@md/cf-page": {
    "port": 8081,
    "watchDirs": ["./lib"] // Ensure changes in lib also refresh server
    // Enable bindings https://developers.cloudflare.com/pages/functions/bindings/
    // , "bindings": {
    //   "DB": { "type": "D1", "id": "00000000-0000-0000-0000-000000000000" },
    //   "KV": { "type": "KV", "id": "00000000000000000000000000000000" }
    // }
  }
}
